# frontend/.env.local로 복사합니다.
# REST 기준 주소입니다. /api 접미사는 붙이지 않습니다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# MediaMTX WHEP 엔드포인트. 설정되지 않은 경로는 화면에서 숨깁니다.
NEXT_PUBLIC_LOCAL_STREAM_URL=http://sentinel.local:8889/sentinel/whep
NEXT_PUBLIC_REMOTE_STREAM_URL=http://localhost:8889/sentinel/whep

# Foxglove WebSocket 지도 경로. 미설정 시 아래 운영 주소가 코드 기본값입니다.
NEXT_PUBLIC_MAP_WS_URL=wss://jetson.sentinel-ugv.xyz:8765
