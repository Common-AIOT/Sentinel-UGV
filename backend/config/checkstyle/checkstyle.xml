<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Java 린터 설정 (S15P11A301-377).

  ## 왜 형식 규칙이 거의 없는가

  들여쓰기·중괄호·줄바꿈은 넣지 않는다. 그런 규칙은 위반이 수백 건 나오고, 그것을
  한 번에 고치면 이 저장소가 자랑하는 「왜」를 담은 주석과 커밋 이력이 형식 변경에
  묻힌다. 게다가 IDE 가 이미 사실상 통일해 두었다.

  대신 **읽어서는 못 잡고 컴파일도 통과하는 것**만 고른다. 미사용 import, 이름 규칙,
  equals/hashCode 짝, 빈 catch 블록 같은 것들이다.

  ## 도입 시점 실측

  아래 규칙으로 위반 0에서 시작했다. 0에서 시작하지 않으면 아무도 보지 않는다.
  규칙을 넓히는 것은 다음 사람의 몫이며, 넓힐 때는 위반을 함께 정리하는 MR 로 한다.
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="TreeWalker">
    <!-- 컴파일은 통과하지만 남아 있으면 안 되는 것들 -->
    <module name="UnusedImports">
      <!-- javadoc {@link} 에서만 쓰는 import 는 미사용이 아니다.
           EncounterQueryService 가 EncounterWriter 를 그렇게 참조한다. -->
      <property name="processJavadoc" value="true"/>
    </module>
    <module name="RedundantImport"/>
    <module name="IllegalImport"/>

    <!-- 이름 규칙. 4스택 모노레포에서 이미 지켜지고 있는 것을 고정한다. -->
    <module name="PackageName"/>
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="LocalVariableName"/>
    <module name="ParameterName"/>
    <module name="ConstantName">
      <!-- `log` 는 예외다. SLF4J 관례이자 Lombok `@Slf4j` 가 만들어 내는 이름이라
           대문자로 바꾸면 이 저장소 안에서 두 형태가 갈린다(수동 선언 7곳,
           @Slf4j 1곳). 다른 이름을 막는 효과는 그대로 남는다. -->
      <property name="format" value="^(log|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
    </module>

    <!-- 짝이 어긋나면 조용히 틀리는 것들 -->
    <module name="EqualsHashCode"/>
    <module name="CovariantEquals"/>
    <module name="StringLiteralEquality"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>

    <!-- 삼킨 예외는 로그에도 안 남는다 -->
    <module name="EmptyCatchBlock">
      <!-- 의도한 무시는 주석이나 변수명으로 밝히면 통과한다 -->
      <property name="exceptionVariableName" value="expected|ignore|ignored"/>
      <property name="commentFormat" value=".*"/>
    </module>

    <!-- 대입이 조건문 안에 숨는 것 -->
    <module name="InnerAssignment"/>
    <module name="FallThrough"/>
  </module>

  <!-- 탭·공백이 한 파일에서 섞이면 diff 가 지저분해진다. 이것만 형식 규칙이다. -->
  <module name="FileTabCharacter"/>
</module>
