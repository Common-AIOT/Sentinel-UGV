# 이 파일을 .env로 복사한 뒤 실제 값으로 교체한다.
# 실제 키를 .env.example 또는 Git에 커밋하지 않는다.
GMS_KEY=replace_with_team_gms_key

# GMS/OpenAI 호환 설정
SENTINEL_GMS_BASE=https://gms.ssafy.io/gmsapi/api.openai.com/v1
# 벤치마크의 Claude·Gemini 후보는 각 공급자의 GMS 전용 엔드포인트를 자동 사용한다.
SENTINEL_LLM=gpt-5.4-mini
SENTINEL_LLM_TIMEOUT=10

# 장애 대응 정책: 최초 호출을 포함해 최대 2회
SENTINEL_GMS_MAX_ATTEMPTS=2
SENTINEL_GMS_RETRY_DELAY=0.5
SENTINEL_GMS_PROBE_TIMEOUT=2

# STT 실행 위치. 기본 local은 기존 Jetson faster-whisper 경로를 그대로 사용한다.
# GPU 서버를 TLS 프록시/SSH 터널 뒤에 준비한 뒤에만 remote로 전환한다.
SENTINEL_STT_BACKEND=local
# SENTINEL_ASR_BASE_URL=https://asr.example.internal
# SENTINEL_ASR_API_KEY=replace_with_random_asr_key
# SENTINEL_ASR_TIMEOUT=8
# SENTINEL_ASR_CONNECT_TIMEOUT=2
# SENTINEL_ASR_MAX_ATTEMPTS=2
# SENTINEL_ASR_RETRY_DELAY=0.2
# SENTINEL_ASR_MODEL_LABEL=Qwen/Qwen3-ASR-1.7B
# 평문 HTTP는 loopback 외에는 기본 거부한다. 격리된 개발망에서만 명시적으로 켠다.
# SENTINEL_ASR_ALLOW_INSECURE_HTTP=0

# 세션 기록 저장 위치. 비워 두면 저장하지 않는다(기본).
# 실제 음성이 남는 개인정보이므로 진단이 필요할 때만 지정하고, 끝나면 삭제한다.
# SENTINEL_SESSION_LOG_DIR=~/sessions
