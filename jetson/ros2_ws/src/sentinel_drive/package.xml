<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sentinel_drive</name>
  <version>0.1.0</version>
  <description>/cmd_vel 전륜 조향 역운동학 (S15P11A301-234·297). 자율 명령을 esp32_motor_bridge 의 후륜 mm/s + 전륜 조향각 mdeg JSON 계약으로 변환한다. 2026-08-06 하드웨어 변경으로 차동 구동에서 자전거 모델(Ackermann 근사)로 되돌아왔다.</description>
  <maintainer email="team@example.com">Sentinel Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
