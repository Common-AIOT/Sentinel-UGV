<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>esp32_bridge</name>
  <version>0.1.0</version>
  <description>모터·센서 ESP32와 USB 직렬(COBS+CRC16)로 통신하는 브리지 (S15P11A301-84). 통신 계층만 다루며 BTS7960 PWM 제어·차량 기구학 변환은 포함하지 않는다.</description>
  <maintainer email="team@example.com">Sentinel Team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export><build_type>ament_python</build_type></export>
</package>
