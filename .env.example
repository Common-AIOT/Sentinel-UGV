# 이 파일은 모노레포 전체의 변수 이름 참고용입니다.
# 프런트 블록은 frontend/.env.local, 백엔드 로컬 블록은 backend/.env.local에 둡니다.
# Jetson 런타임 설정은 ROS 파라미터 YAML과 ~/.config/sentinel/secrets.yaml을 사용합니다.

# Frontend (frontend/.env.local)
# /api 접미사를 붙이지 않습니다. STOMP 주소는 이 값에서 {http,https}->{ws,wss}로
# 변환한 뒤 /ws를 붙여 자동 생성하므로 NEXT_PUBLIC_WS_URL 변수는 사용하지 않습니다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_LOCAL_STREAM_URL=http://sentinel.local:8889/sentinel/whep
NEXT_PUBLIC_REMOTE_STREAM_URL=http://localhost:8889/sentinel/whep
NEXT_PUBLIC_MAP_WS_URL=wss://jetson.sentinel-ugv.xyz:8765

# Backend local (backend/.env.local)
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sentinel_ugv
SPRING_DATASOURCE_USERNAME=myuser
SPRING_DATASOURCE_PASSWORD=secret
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
MQTT_URL=tcp://localhost:1883
MQTT_CLIENT_ID=spring-backend
MQTT_USERNAME=
MQTT_PASSWORD=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sentinel-ugv-assets
S3_ACCESS_KEY=admin
S3_SECRET_KEY=change-me

# Production Compose (backend/.env; 비밀값은 실제 배포 환경에서 주입)
DOCKER_IMAGE=wonbne/spring-backend:latest
POSTGRES_DB=sentinel_ugv
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me
