# Required in every shared-server deployment. Generate a random value; do not commit it.
ASR_API_KEY=replace-with-a-random-secret

# Disables the ASR_API_KEY check entirely. Local single-user testing only —
# never enable it on the shared server. Default is 0 (auth enforced).
ASR_ALLOW_UNAUTHENTICATED=0

# Physical GPU allocated to A301. Inside the process this becomes logical cuda:0.
ASR_CUDA_VISIBLE_DEVICES=3

ASR_MODEL_ID=Qwen/Qwen3-ASR-1.7B
ASR_DTYPE=bfloat16

# Transformers attention backend (e.g. flash_attention_2). Empty = library default.
ASR_ATTENTION_IMPLEMENTATION=

# Conservative defaults for the shared L40S. Increase only after S15P11A301-261 measurements.
ASR_MAX_CONCURRENCY=1
ASR_MAX_INFERENCE_BATCH_SIZE=4
ASR_QUEUE_TIMEOUT_SECONDS=0.05
ASR_MAX_AUDIO_BYTES=16777216
ASR_MAX_AUDIO_SECONDS=30
ASR_MAX_NEW_TOKENS=256

# Bind locally and publish through an authenticated TLS reverse proxy or tunnel.
ASR_HOST=127.0.0.1
ASR_PORT=18100
