# backend/.env.local로 복사해 로컬 Spring Boot 실행에 사용합니다.
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sentinel_ugv
SPRING_DATASOURCE_USERNAME=myuser
SPRING_DATASOURCE_PASSWORD=secret
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

MQTT_URL=tcp://localhost:1883
MQTT_CLIENT_ID=spring-backend
MQTT_USERNAME=
MQTT_PASSWORD=

# 로컬 S3 호환 스토리지를 따로 띄운 경우에만 업로드 API가 정상 동작합니다.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sentinel-ugv-assets
S3_ACCESS_KEY=admin
S3_SECRET_KEY=change-me
