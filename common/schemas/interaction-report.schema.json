{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-ugv.xyz/schemas/interaction-report.schema.json",
  "title": "음성 상호작용 보고",
  "description": "비전 encounter에서 시작한 음성 세션의 구조화 결과와 규칙 기반 위험 참고값이다(S15P11A301-159).",
  "type": "object",
  "required": [
    "interactionId",
    "encounterId",
    "missionId",
    "visionPersonCount",
    "encounterPose",
    "additionalPersonReports",
    "startedAt",
    "endedAt",
    "sessionReport",
    "riskAssessment",
    "usedFallback"
  ],
  "additionalProperties": false,
  "properties": {
    "interactionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "encounterId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "missionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "visionPersonCount": {
      "type": "integer",
      "minimum": 0
    },
    "encounterPose": {
      "description": "음성 상호작용 당시 로봇 Encounter 위치. 요구조자의 정밀 좌표가 아니다.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["x", "y", "yaw", "mapId"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "yaw": { "type": "number" },
        "mapId": { "type": ["string", "null"] }
      }
    },
    "additionalPersonReports": {
      "description": "COUNT 답변에 포함된 추가 요구조자 미확인 제보. 좌표나 주행 목표가 아니다.",
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subjectText",
          "reportedCount",
          "countStatus",
          "locationText",
          "reportedFloor",
          "groundingStatus",
          "responseStatus",
          "certaintyStatus",
          "rawUtterance",
          "verificationStatus",
          "operatorReviewRequired"
        ],
        "properties": {
          "subjectText": { "type": ["string", "null"], "minLength": 1 },
          "reportedCount": { "type": ["integer", "null"], "minimum": 1 },
          "countStatus": {
            "enum": ["EXACT", "PRESENCE_CONFIRMED_COUNT_UNKNOWN"]
          },
          "locationText": { "type": ["string", "null"], "minLength": 1 },
          "reportedFloor": { "type": ["integer", "null"] },
          "groundingStatus": { "const": "UNGROUNDED" },
          "responseStatus": {
            "enum": ["RESPONSIVE", "UNRESPONSIVE", "UNKNOWN"]
          },
          "certaintyStatus": { "enum": ["ASSERTED", "TENTATIVE"] },
          "rawUtterance": { "type": "string", "minLength": 1 },
          "verificationStatus": { "const": "UNVERIFIED" },
          "operatorReviewRequired": { "const": true }
        },
        "allOf": [
          {
            "if": { "properties": { "countStatus": { "const": "EXACT" } } },
            "then": { "properties": { "reportedCount": { "type": "integer", "minimum": 1 } } }
          },
          {
            "if": { "properties": { "countStatus": { "const": "PRESENCE_CONFIRMED_COUNT_UNKNOWN" } } },
            "then": { "properties": { "reportedCount": { "type": "null" } } }
          }
        ]
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "sessionReport": {
      "type": "object",
      "required": [
        "responseScope",
        "anyResponseDetected",
        "reportedResponsiveCount",
        "reportedCountStatus",
        "countConfidence",
        "mobilityStatus",
        "urgentConditionReported",
        "operatorReviewRequired",
        "terminationReason"
      ],
      "additionalProperties": false,
      "properties": {
        "responseScope": {
          "const": "GROUP"
        },
        "anyResponseDetected": {
          "type": ["boolean", "null"]
        },
        "reportedResponsiveCount": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "reportedCountStatus": {
          "enum": [
            "SELF_REPORTED_GROUP_COUNT",
            "CONFIRMED_BY_OPERATOR",
            "UNKNOWN"
          ]
        },
        "countConfidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "mobilityStatus": {
          "enum": ["YES", "NO", "UNKNOWN"]
        },
        "urgentConditionReported": {
          "enum": ["YES", "NO", "UNKNOWN"]
        },
        "operatorReviewRequired": {
          "type": "boolean"
        },
        "terminationReason": {
          "enum": [
            "NORMAL",
            "TIMEOUT",
            "ABORTED_MANUAL",
            "ABORTED_SAFETY",
            "AUDIO_DEVICE_ERROR",
            "GMS_UNAVAILABLE",
            "UNKNOWN"
          ]
        }
      }
    },
    "riskAssessment": {
      "type": "object",
      "required": [
        "riskLevel",
        "riskReasons",
        "ruleVersion",
        "operatorReviewRequired"
      ],
      "additionalProperties": false,
      "properties": {
        "riskLevel": {
          "enum": ["IMMEDIATE", "URGENT", "DELAYED", "UNKNOWN"]
        },
        "riskReasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ruleVersion": {
          "description": "riskLevel을 계산한 규칙 버전. 규칙이 바뀌면 올린다. 같은 버전 문자열이 서로 다른 계산을 뜻하면 보고서를 감사할 수 없다.\n\nv1.1(S15P11A301-179)은 terminationReason을 등급 판정의 게이트에서 부가 정보로 바꿨다. v1.0은 종료 사유가 NORMAL이 아니면 수집한 값을 버리고 UNKNOWN을 반환했고, 그래서 답을 모두 받은 세션이 제한 시간을 넘기면 확인된 긴급 상태가 사라졌다.\n\n과거 보고서도 그대로 검증되도록 두 버전을 모두 허용한다.",
          "enum": ["voice-risk-v1.0", "voice-risk-v1.1"]
        },
        "operatorReviewRequired": {
          "type": "boolean"
        }
      }
    },
    "usedFallback": {
      "type": "boolean"
    }
  }
}
