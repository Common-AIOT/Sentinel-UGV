# 이 파일을 ai/stt/.env로 복사한 뒤 replace_* 값만 실제 비밀값으로 교체한다.
# 실제 API 키와 요구조자 음성은 Git에 커밋하지 않는다.

# GMS 구조화 해석
GMS_KEY=replace_with_team_gms_key
SENTINEL_LLM=gpt-5.4-mini
SENTINEL_LLM_TIMEOUT=10

# L40S GPU 서버의 Qwen3-ASR을 사용하는 현재 구성
SENTINEL_ASR_BASE_URL=http://70.12.130.105:18100
SENTINEL_ASR_API_KEY=replace_with_gpu_asr_api_key

# 평문 HTTP는 API 키와 음성을 암호화하지 않는다. 위 주소는 Jetson 실기 연결을
# 확인하는 격리 개발망에서만 사용한다. 운영 유지 시 HTTPS 또는 승인된 터널로 바꾼다.
SENTINEL_ASR_ALLOW_INSECURE_HTTP=1
SENTINEL_ASR_TIMEOUT=8
SENTINEL_ASR_CONNECT_TIMEOUT=2
SENTINEL_ASR_MAX_ATTEMPTS=2
SENTINEL_ASR_RETRY_DELAY=0.2

# 실기 검증 증적. 실제 음성이 저장되므로 검증 후 보존 정책에 따라 삭제한다.
SENTINEL_SESSION_LOG_DIR=sessions

# 선택 설정. 현재 기본값과 같아서 보통 추가하지 않는다.
# SENTINEL_GMS_BASE=https://gms.ssafy.io/gmsapi/api.openai.com/v1
# SENTINEL_GMS_MAX_ATTEMPTS=2
# SENTINEL_GMS_RETRY_DELAY=0.5
# SENTINEL_GMS_PROBE_TIMEOUT=2
# SENTINEL_ASR_MODEL_LABEL=Qwen/Qwen3-ASR-1.7B
