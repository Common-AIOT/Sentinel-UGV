<?xml version="1.0"?>
<!--
  Sentinel UGV TF 정적 골격 (S15P11A301-74)

  명세 04장 8.3·03장 22.3의 TF 트리를 그대로 기록한다.

  ## 오프셋은 실측이다 (2026-08-08, S15P11A301-344)

  차체 개방 상태에서 줄자로 실측했다. 원점과 축의 정의:

    원점 = 후륜 축 중앙을 바닥에 수직 투영한 점 (base_footprint == base_link)
    x = 전방, y = 좌측, z = 상방(바닥 기준)

  base_link 를 지면에 두는 이유: 오도메트리·자전거 모델이 후륜 축 중심을
  기준으로 적분하고, nav2.yaml 의 footprint 다각형(앞 0.80/뒤 -0.11)도 이
  원점을 전제한다. 모든 실측이 바닥 기준 z 로 이루어졌으므로 변환 없이 그대로
  들어간다. 교차 검증: 전륜 x=0.683 이 휠베이스 실측과 정확히 일치, 전륜 간격
  0.533 이 트랙폭 0.53 과 0.6% 안 — 원점을 제대로 잡았다는 증거다.

  미실측 없음 — 오프셋·자세 전부 실측 반영 완료 (2026-08-08). 라이다 yaw 와
  카메라 pitch 는 기능 시험으로 확정했다(각 조인트 주석에 방법과 근거).

  - 실측 파라미터가 더 쌓이면 xacro 승격을 검토한다(현재는 의존성 최소화를 위해
    plain URDF).
  - 휠 조인트는 구동/조향 구현 시 continuous/revolute 전환을 검토한다.
  - TF 골격 전용이므로 visual/collision/inertial은 정의하지 않는다.
  - 이 파일이 발행하는 범위는 base_footprint 이하다.
    odom -> base_footprint는 오도메트리(EKF), map -> odom은 SLAM이 발행하며
    둘 다 이 파일 범위 밖이다. 따라서 이 패키지만 실행한 상태에서
    map 또는 odom을 기준으로 한 tf2_echo는 실패하는 것이 정상이다.
    트리 검증은 base_footprint를 기준으로 한다.
-->
<robot name="sentinel">

  <link name="base_footprint"/>
  <link name="base_link"/>
  <link name="imu_link"/>
  <link name="rear_drive_wheel_link"/>
  <link name="front_left_wheel_link"/>
  <link name="front_right_wheel_link"/>
  <link name="lidar_link"/>
  <link name="camera_link"/>
  <link name="camera_optical_frame"/>
  <link name="ultrasonic_front_link"/>
  <link name="ultrasonic_rear_link"/>

  <!-- base_footprint(지면 투영) == base_link. 항등으로 두는 근거는 머리말. -->
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- IMU (MPU6050). 위치·자세 모두 실측 (2026-08-08, S15P11A301-344).

       rpy 는 기능 시험으로 판정했다: 정지 시 가속도 (ax,ay,az) = (-1.65, -0.40,
       +10.04) 가 로봇 자세·방위와 무관하게 상시 존재했고(90도 회전 후에도 동일
       - 바닥 경사 아님), 브레드보드 마운트가 앞으로 기운 것을 육안으로 확인했다.

         pitch = asin(1.65/10.18) = +9.3도  (앞으로 숙임)
         roll  = asin(0.40/10.18) = -2.3도  (왼쪽이 낮음)
         검산: 이 rpy 로 중력을 회전하면 (-1.65, -0.39, +10.0) - 실측 재현

       이 rpy 를 지우면 EKF 가 "로봇이 항상 9도 내리막 주행 중"으로 믿어 중력
       x성분을 감속으로 오독한다. 축 매핑 자체는 REP-103 그대로임이 같은 시험으로
       확인됐다(앞들기->ax+, 왼쪽들기->ay+, 반시계->gz+) - 펌웨어 IMU_AXIS_SOURCE
       항등 설정과 일치하므로 그쪽은 손대지 않는다. -->
  <joint name="base_link_to_imu_link" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.233 -0.010 0.215" rpy="-0.0393 0.1628 0"/>
  </joint>

  <!-- 후륜 구동축. 원점 정의상 x=y=0, z=축 높이(바퀴 반지름 0.125).
       구동 구현 시 continuous 전환 검토. -->
  <joint name="base_link_to_rear_drive_wheel_link" type="fixed">
    <parent link="base_link"/>
    <child link="rear_drive_wheel_link"/>
    <origin xyz="0 0 0.125" rpy="0 0 0"/>
  </joint>

  <!-- 전륜 좌/우. 접지 중심 실측(x=0.683=휠베이스, y=+0.268/-0.265)에 축 높이
       z=0.125(반지름)를 더한 바퀴 중심이다. 좌우 y 의 3mm 비대칭은 줄자 오차
       범위다. 조향 확정 시 revolute 전환 검토. -->
  <joint name="base_link_to_front_left_wheel_link" type="fixed">
    <parent link="base_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0.683 0.268 0.125" rpy="0 0 0"/>
  </joint>
  <joint name="base_link_to_front_right_wheel_link" type="fixed">
    <parent link="base_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0.683 -0.265 0.125" rpy="0 0 0"/>
  </joint>

  <!-- 전방 HC-SR04. collision_monitor 가 /range/front 를 점으로 바꿀 때 이 TF 를
       쓰므로 위치 실측이 실제 정지 거리에 그대로 반영된다(§35-7). 전방 범퍼
       돌출부, 송·수신 원통 사이 중앙 실측. -->
  <joint name="base_link_to_ultrasonic_front_link" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_front_link"/>
    <origin xyz="0.810 0 0.215" rpy="0 0 0"/>
  </joint>

  <!-- 후방 HC-SR04. 기계적으로 장착돼 있으나 아직 배선·펌웨어 채널이 없다
       (S15P11A301-324 가 배선한다). frame 을 미리 두는 이유: 배선되는 날 TF 가
       준비돼 있어야 하고, 위치 실측은 차체가 열려 있던 지금만 가능했다.
       yaw=pi 로 +x 가 후방을 향한다 - Range 를 점으로 바꿀 때 방향이 곧 값이다. -->
  <joint name="base_link_to_ultrasonic_rear_link" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_rear_link"/>
    <origin xyz="-0.130 0 0.215" rpy="0 0 3.14159265"/>
  </joint>

  <!-- 짐벌 링크 3개를 제거하고 lidar·camera 를 base_link 에 직결했다
       (S15P11A301-279). 짐벌은 v1.1-r4 에서 제외 확정(02장 6.4), 명세 35-2 의
       권장 트리는 base_link 직결이다. -->

  <!-- LiDAR (YDLidar). 회전축 중심 실측 - 지붕 위 마운트라 차체 높이(0.47)보다
       높다.

       장착 yaw=0 은 실측으로 확인됐다 (2026-08-08, S15P11A301-344): 로봇 정면
       114cm 에 벽을 두고 /scan 15프레임을 합산하니 벽의 코사인 곡선이 0도를
       중심으로 대칭이고(수직 방향 -2~0도, 벽 정렬 오차 범위), 수직거리 1.148m 가
       실측 1.14m 와 1cm 안에서 일치했다 - yaw 와 거리 스케일이 함께 검증됐다. -->
  <joint name="base_link_to_lidar_link" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.350 0 0.502" rpy="0 0 0"/>
  </joint>

  <!-- 카메라 본체(REP-103 body: x-전방, y-좌, z-상). 위치 실측(렌즈 중심).

       광축이 위로 30도 들려 있다 (2026-08-08 벽 표시 기능 시험, S15P11A301-344):
       렌즈에서 72.8cm 떨어진 벽에서 영상 세로 정중앙이 높이 85cm 에 걸렸다.
         pitch = atan((0.85 - 0.428) / 0.728) = +30.1도 위 -> URDF pitch = -0.525 rad
       몸통 윗면 수평계 측정 40도와도 정합한다(쐐기꼴 외형 ~10도 + 광축 30도).
       낮은 차체(렌즈 43cm)에서 위로 30도면 2m 앞 성인의 상체가 화면 중앙에
       온다 - 사람 탐지용 의도 장착으로 보인다.

       이 값이 틀리면 사람 방위각->지도 좌표 변환(25.3)과 화면 좌표 기반 판정이
       어긋난다. 마운트를 바꾸면 같은 벽 시험으로 다시 잰다(1분). -->
  <joint name="base_link_to_camera_link" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.770 0.010 0.428" rpy="0 -0.525 0"/>
  </joint>

  <!-- REP-103 optical 관례(x-우, y-하, z-전방). rpy = (-pi/2, 0, -pi/2),
       quaternion (-0.5, 0.5, -0.5, 0.5).
       S15P11A301-62 카메라 계약: /camera/image_raw/compressed의 frame_id -->
  <joint name="camera_link_to_camera_optical_frame" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>

</robot>
